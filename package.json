{
  "name": "dsh-vmouse",
  "version": "0.1.0",
  "description": "macOS 虚拟鼠标：不移动物理光标、不抢前台焦点，就能读取窗口并点击、输入、滚动。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "helper/vmouse-helper.swift",
    "mcp/server.mjs",
    "locale/*.json",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "macos",
    "virtual-mouse",
    "computer-use",
    "accessibility",
    "desktop-automation"
  ],
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "bin": {
    "dsh-vmouse-mcp": "./mcp/server.mjs"
  }
}
